# Demo mode: set to "true" to serve a static mock paper corpus from /api/retrieve
# instead of hitting live scholarly APIs. Must be enabled explicitly — it no
# longer activates automatically just because Gemini credentials are missing.
DEMO_MODE=false

# Gemini / Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# For Vercel/hosted deployments, use JSON content instead of a local file path.
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-google-cloud-project"}
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1

# Model routing
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_REASONING_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_SUMMARY_MODEL=gemini-2.5-flash
GEMINI_TRANSLATION_MODEL=gemini-2.5-flash
GEMINI_QUERY_MODEL=gemini-2.5-flash
NEXT_PUBLIC_GEMINI_REASONING_LABEL=Gemini 2.5 Pro
NEXT_PUBLIC_GEMINI_SUMMARY_LABEL=Gemini 2.5 Flash

# Scholarly APIs
OPENALEX_EMAIL=your-email@example.com
SEMANTIC_SCHOLAR_API_KEY=optional
CORE_API_KEY=optional
NCBI_API_KEY=optional
UNPAYWALL_EMAIL=your-email@example.com

# Supabase faculty directory
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
